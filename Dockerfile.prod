FROM node:14.15.5 AS build

# Install Angular CLI compatible with this project
RUN npm install -g @angular/cli@6.1.4

WORKDIR /app

# Install dependencies (same strategy as dev Dockerfile for node-sass)
COPY package.json package-lock.json ./

# 1. Install all deps WITHOUT running postinstall scripts (skip node-sass compilation)
RUN npm install --ignore-scripts

# 2. Remove the incompatible nested node-sass@4.9.2 from @angular-devkit
RUN rm -rf node_modules/@angular-devkit/build-angular/node_modules/node-sass

# 3. Install node-sass@4.14.1 (compatible avec Node 14) à la racine
RUN npm install node-sass@4.14.1 --unsafe-perm --no-save

# 4. Rebuild native addons
RUN npm rebuild --unsafe-perm

# 5. Copier le reste du projet et construire en mode production
COPY . .

RUN ng build --prod --output-path=dist/front --aot

# ---- Runtime image: nginx pour servir les fichiers statiques ----
FROM nginx:1.27-alpine AS runtime

WORKDIR /usr/share/nginx/html

# Copier le build Angular
COPY --from=build /app/dist/front ./

# Config nginx personnalisée pour SPA Angular
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

